# =====================================================================
# FasoCarbu backend - variables d'environnement
# Copier ce fichier en `.env` (ignoré par git) et remplir les valeurs.
# =====================================================================

# Profil Spring : dev (données de démo) | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=9090

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fasocarbu_db
DB_USER=postgres
DB_PASSWORD=postgres
# prod uniquement : disable | prefer | require
DB_SSLMODE=require

# JWT : au moins 32 caractères aléatoires (ex. `openssl rand -base64 48`)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# CORS : origines autorisées, séparées par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:*

# Email (Brevo)
BREVO_API_KEY=

# Firebase Cloud Messaging : contenu JSON du compte de service (une ligne)
FIREBASE_CONFIG_JSON=

# Dossier de stockage des photos de profil
UPLOAD_DIR=./uploads
